# ============================================================
# Modele de configuration. Copier en .env.local et renseigner.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Projet EXTERNAL, PARTAGE avec une autre application : toutes les tables
# MG2030 sont prefixees mg2030_, et auth.users est COMMUN aux deux
# applications. Voir docs/SCHEMA.md §1 pour les consequences de securite.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Cloudflare R2 (lot 11) ──────────────────────────────────
# Upload DIRECT navigateur par URL pre-signee, jamais a travers une fonction
# serveur (brief §4). Ces valeurs restent cote serveur.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# ── Vercel Cron (lot 13) ────────────────────────────────────
# Secret partage protegeant /api/cron/* : sans lui, n importe qui declencherait
# l evaluation des retards.
# CRON_SECRET=

# ── Cle de SERVICE (contourne la RLS) ───────────────────────
# UN SEUL usage : /api/cron/schedule-checks, qui n a pas de session utilisateur
# (voir lib/supabase/service.ts). PAS de prefixe NEXT_PUBLIC_ : elle ne doit
# jamais atteindre le navigateur. Un garde-fou (npm run check:service-key)
# echoue le build si un autre fichier y touche.
# SUPABASE_SERVICE_ROLE_KEY=
